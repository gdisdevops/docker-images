{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "ignorePresets": [
        ":prHourlyLimit2"
    ],
    "baseBranchPatterns": [
        "master"
    ],
    "branchConcurrentLimit": 20,
    "prConcurrentLimit": 10,
    "prHourlyLimit": 10,
    "enabledManagers": [
        "custom.regex"
    ],
    "packageRules": [
        {
            "matchUpdateTypes": [
                "major"
            ],
            "groupName": "major dependency updates",
            "groupSlug": "major",
            "matchPackageNames": [
                "*"
            ]
        },
        {
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "groupName": "minor and patch dependency updates",
            "groupSlug": "non-major",
            "matchPackageNames": [
                "*"
            ]
        },
        {
            "matchDatasources": [
                "pypi"
            ],
            "matchPackageNames": [
                "checkov",
                "ansible",
                "hvac"
            ],
            "versioning": "python"
        },
        {
            "matchDatasources": [
                "github-releases"
            ],
            "matchPackageNames": [
                "helm/helm",
                "open-policy-agent/conftest",
                "sigstore/cosign",
                "getsentry/sentry-cli",
                "DaspawnW/vault-crd-helm-renderer",
                "kyverno/kyverno",
                "c3xdev/c3x",
                "kubernetes/kubernetes",
                "tofuutils/tenv"
            ],
            "versioning": "semver"
        },
        {
            "matchDatasources": [
                "github-releases"
            ],
            "matchPackageNames": [
                "hashicorp/vault",
                "hashicorp/packer",
                "hashicorp/terraform"
            ],
            "versioning": "hashicorp"
        }
    ],
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": ["/.*\\/Dockerfile/"],
            "matchStrings": [".*\\sVAULT_VERSION=(?<currentValue>\\d.*\\.?)"],
            "depNameTemplate": "hashicorp/vault",
            "datasourceTemplate": "github-releases"
        },
        {
            "customType": "regex",
            "managerFilePatterns": ["/.*\\/Dockerfile/"],
            "matchStrings": [".*\\sPACKER_VERSION=(?<currentValue>\\d.*\\.?)"],
            "depNameTemplate": "hashicorp/packer",
            "datasourceTemplate": "github-releases"
        },
        {
            "customType": "regex",
            "managerFilePatterns": ["/.*\\/Dockerfile/"],
            "matchStrings": [".*\\sTERRAFORM_1_VERSION=(?<currentValue>\\d.*\\.?)"],
            "depNameTemplate": "hashicorp/terraform",
            "datasourceTemplate": "github-releases"
        },
        {
            "customType": "regex",
            "managerFilePatterns": ["/.*\\/Dockerfile/"],
            "matchStrings": [".*\\sHELM_VERSION=(?<currentValue>\\d.*\\.?)"],
            "depNameTemplate": "helm/helm",
            "datasourceTemplate": "github-releases",
            "extractVersionTemplate": "^v(?<version>.*)$"
        },
        {
            "customType": "regex",
            "managerFilePatterns": ["/.*\\/Dockerfile/"],
            "matchStrings": [".*\\sANSIBLE_VERSION=(?<currentValue>\\d.*\\.?)"],
            "depNameTemplate": "ansible",
            "datasourceTemplate": "pypi"
        },
        {
            "customType": "regex",
            "managerFilePatterns": ["/.*\\/Dockerfile/"],
            "matchStrings": [".*\\sCONFTEST_VERSION=(?<currentValue>\\d.*\\.?)"],
            "depNameTemplate": "open-policy-agent/conftest",
            "datasourceTemplate": "github-releases",
            "extractVersionTemplate": "^v(?<version>.*)$"
        },
        {
            "customType": "regex",
            "managerFilePatterns": ["/.*\\/Dockerfile/"],
            "matchStrings": [".*\\sCOSIGN_VERSION=(?<currentValue>\\d.*\\.?)"],
            "depNameTemplate": "sigstore/cosign",
            "datasourceTemplate": "github-releases",
            "extractVersionTemplate": "^v(?<version>.*)$"
        },
        {
            "customType": "regex",
            "managerFilePatterns": ["/.*\\/Dockerfile/"],
            "matchStrings": [".*\\sSENTRY_CLI_VERSION=(?<currentValue>\\d.*\\.?)"],
            "depNameTemplate": "getsentry/sentry-cli",
            "datasourceTemplate": "github-releases",
            "extractVersionTemplate": "^(?<version>.*)$"
        },
        {
            "customType": "regex",
            "managerFilePatterns": ["/.*\\/Dockerfile/"],
            "matchStrings": [".*\\sCHECKOV_VERSION=(?<currentValue>\\d.*\\.?)"],
            "depNameTemplate": "checkov",
            "datasourceTemplate": "pypi"
        },
        {
            "customType": "regex",
            "managerFilePatterns": ["/.*\\/Dockerfile/"],
            "matchStrings": [".*\\sVAULT_CRD_RENDERER_VERSION=(?<currentValue>\\d.*\\.?)"],
            "depNameTemplate": "DaspawnW/vault-crd-helm-renderer",
            "datasourceTemplate": "github-releases",
            "extractVersionTemplate": "^v(?<version>.*)$"
        },
        {
            "customType": "regex",
            "managerFilePatterns": ["/.*\\/Dockerfile/"],
            "matchStrings": [".*\\sKYVERNO_CLI_VERSION=(?<currentValue>\\d.*\\.?)"],
            "depNameTemplate": "kyverno/kyverno",
            "datasourceTemplate": "github-releases",
            "extractVersionTemplate": "^v(?<version>.*)$"
        },
        {
            "customType": "regex",
            "managerFilePatterns": ["/.*\\/Dockerfile/"],
            "matchStrings": [".*\\sC3X_VERSION=(?<currentValue>\\d.*\\.?)"],
            "depNameTemplate": "c3xdev/c3x",
            "datasourceTemplate": "github-releases",
            "extractVersionTemplate": "^v(?<version>.*)$"
        },
        {
            "customType": "regex",
            "managerFilePatterns": ["/.*\\/Dockerfile/"],
            "matchStrings": [".*\\sPIP_HVAC_VERSION=(?<currentValue>\\d.*\\.?)"],
            "depNameTemplate": "hvac",
            "datasourceTemplate": "pypi"
        },
        {
            "customType": "regex",
            "managerFilePatterns": ["/.*\\/Dockerfile/"],
            "matchStrings": [".*\\sKUBECTL_VERSION=(?<currentValue>\\d.*\\.?)"],
            "depNameTemplate": "kubernetes/kubernetes",
            "datasourceTemplate": "github-releases",
            "extractVersionTemplate": "^v(?<version>.*)$"
        },
        {
            "customType": "regex",
            "managerFilePatterns": ["/.*\\/Dockerfile/"],
            "matchStrings": [".*\\sTENV_VERSION=(?<currentValue>\\d.*\\.?)"],
            "depNameTemplate": "tofuutils/tenv",
            "datasourceTemplate": "github-releases",
            "extractVersionTemplate": "^v(?<version>.*)$"
        }
    ]
}
